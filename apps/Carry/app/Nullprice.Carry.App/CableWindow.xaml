<Window x:Class="Nullprice.Carry.App.CableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carry — direct cable / LAN transfer" Width="720" Height="610"
        MinWidth="640" MinHeight="560" WindowStartupLocation="CenterOwner"
        Background="#F3F5F9" FontFamily="Segoe UI" Foreground="#18202B">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Background="#18202B" Padding="30,22">
            <StackPanel>
                <TextBlock Text="DIRECT TRANSFER" Foreground="#9BAAFF" FontWeight="Bold"/>
                <TextBlock Text="Cable or local network" Foreground="White" FontSize="25"
                           FontWeight="SemiBold" Margin="0,5,0,3"/>
                <TextBlock Text="No Windows share, username, or network credentials."
                           Foreground="#C8CED8"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="1" Margin="28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ReceiveMode" Content="Receive on new laptop" IsChecked="True"
                             FontSize="15" FontWeight="SemiBold" Margin="0,0,28,0"
                             Checked="ModeChanged"/>
                <RadioButton x:Name="SendMode" Content="Send from old laptop"
                             FontSize="15" FontWeight="SemiBold" Checked="ModeChanged"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="18" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock x:Name="InstructionText" TextWrapping="Wrap"
                               Text="Connect both laptops by Ethernet cable or to the same router. Start Receive here first."
                               Foreground="#687385"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Transfer code" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBox x:Name="CodeBox" Grid.Column="1" Width="130" HorizontalAlignment="Left"
                                 Margin="16,0,0,0" FontSize="19" FontWeight="Bold"
                                 MaxLength="6" Padding="8,4"/>
                    </Grid>
                    <Grid x:Name="AddressRow" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AddressLabel" Text="This laptop's IP" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="AddressBox" Grid.Column="1" Margin="16,0,0,0"
                                 Padding="8,4" IsReadOnly="True"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="18" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock x:Name="PathLabel" Text="Save incoming package to" FontWeight="SemiBold"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Height="36" Padding="8,0" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="BrowseClicked"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#E9ECF4" CornerRadius="8" Padding="16"
                    Margin="0,12,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold"/>
                    <TextBlock x:Name="CurrentItemText" Foreground="#687385" Margin="0,4,0,9"
                               TextTrimming="CharacterEllipsis"/>
                    <ProgressBar x:Name="TransferProgress" Height="9"/>
                    <TextBlock x:Name="ProgressText" Foreground="#687385"
                               HorizontalAlignment="Right" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed"
                        HorizontalAlignment="Left" Click="CancelClicked"/>
                <Button x:Name="StartButton" Content="Start receiving" HorizontalAlignment="Right"
                        Background="#4C66E8" Foreground="White" BorderThickness="0"
                        Click="StartClicked"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
