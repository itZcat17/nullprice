<Window x:Class="Nullprice.Carry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Carry — laptop migration" Width="780" Height="710"
        MinWidth="680" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="#F3F5F9" FontFamily="Segoe UI" Foreground="{StaticResource Ink}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#18202B" Padding="34,24">
            <StackPanel>
                <TextBlock Text="CARRY" Foreground="#9BAAFF" FontWeight="Bold" FontSize="13"/>
                <TextBlock Text="Move into your new laptop." Foreground="White" FontWeight="SemiBold"
                           FontSize="27" Margin="0,5,0,4"/>
                <TextBlock Text="Documents and VS Code, packaged locally. Nothing is uploaded."
                           Foreground="#C8CED8" FontSize="14"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="BackupMode" Content="Back up this laptop" IsChecked="True"
                             FontSize="16" FontWeight="SemiBold" Margin="0,0,28,0"
                             Checked="ModeChanged"/>
                <RadioButton x:Name="RestoreMode" Content="Restore on new laptop"
                             FontSize="16" FontWeight="SemiBold" Checked="ModeChanged"/>
            </StackPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock x:Name="PathLabel" Text="Save the transfer folder to" FontWeight="SemiBold"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" Height="38" VerticalContentAlignment="Center"
                                 Padding="10,0" FontSize="14"/>
                        <Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="BrowseClicked"/>
                    </Grid>
                    <TextBlock x:Name="PathHint" Text="Choose an external drive, USB disk, or shared network folder."
                               Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="20" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="What to carry" FontWeight="SemiBold"/>
                    <CheckBox x:Name="DocumentsCheck" IsChecked="True" Content="Everything in Documents"/>
                    <CheckBox x:Name="VsCodeCheck" IsChecked="True"
                              Content="VS Code settings, keybindings, snippets, profiles, and extensions"/>
                    <Grid x:Name="AppsRow" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AppsCheck" Content="Selected apps (reinstall on the new laptop)"/>
                        <Button x:Name="ReviewButton" Grid.Column="1" Content="Choose apps &amp; review old files…"
                                Padding="12,6" Click="ReviewClicked"/>
                    </Grid>
                    <StackPanel x:Name="InactivityRow" Orientation="Horizontal" Margin="0,7,0,0">
                        <TextBlock Text="Flag files not active for" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}"/>
                        <ComboBox x:Name="InactivityMonths" Width="105" Margin="8,0" SelectedIndex="2">
                            <ComboBoxItem Content="3 months" Tag="3"/>
                            <ComboBoxItem Content="6 months" Tag="6"/>
                            <ComboBoxItem Content="12 months" Tag="12"/>
                            <ComboBoxItem Content="24 months" Tag="24"/>
                            <ComboBoxItem Content="36 months" Tag="36"/>
                        </ComboBox>
                        <TextBlock Text="(report only)" VerticalAlignment="Center"
                                   Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                    <TextBlock x:Name="ComponentsNote"
                               Text="✓ System components are automatic (.NET, ASP.NET, VC++, Node, Python)"
                               Foreground="#4C66E8" Margin="0,9,0,0" FontSize="13"/>
                    <CheckBox x:Name="OverwriteCheck" Visibility="Collapsed"
                              Content="Replace files that already exist on this laptop"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" x:Name="ProgressPanel" Background="#E9ECF4" CornerRadius="8"
                    Padding="18" Margin="0,14,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="Ready" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ItemText" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Muted}" Margin="0,5,0,10" MaxHeight="42"/>
                    <ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ProgressText" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Right" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Visibility="Collapsed"
                        HorizontalAlignment="Left" Click="CancelClicked"/>
                <Button x:Name="StartButton" Content="Create transfer →" HorizontalAlignment="Right"
                        Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                        Click="StartClicked"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
