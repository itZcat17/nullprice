<Window x:Class="Nullprice.Sheaf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sheaf" Height="760" Width="1100"
        MinHeight="560" MinWidth="820"
        Background="#EEF0F1"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#12171A" />
        <SolidColorBrush x:Key="InkSoft" Color="#5A656C" />
        <SolidColorBrush x:Key="Line" Color="#DCE1E4" />
        <SolidColorBrush x:Key="Accent" Color="#12674A" />
        <SolidColorBrush x:Key="Warn" Color="#A8442B" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C3CBD0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="SHEAF" FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
            <TextBlock Text="Rearrange, merge, split, rotate, and extract pages entirely on this machine."
                       Foreground="{StaticResource InkSoft}" Margin="0,2,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="AddFilesButton" Content="Add PDF(s)…" Click="OnAddFiles" Margin="0,0,7,0" />
            <Button x:Name="ClearButton" Content="Clear all" Click="OnClearAll" Margin="0,0,20,0" />
            <TextBlock Text="OUTPUT" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button x:Name="ChooseOutputButton" Content="Choose output PDF…" Click="OnChooseOutput" />
            <TextBlock x:Name="OutputText" Text="No output file chosen" VerticalAlignment="Center"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="10,0,0,0"
                       Foreground="{StaticResource InkSoft}" />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PageGrid" Margin="10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,14">
            <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="1"
                         Foreground="{StaticResource Accent}" Background="#DCE1E4" BorderThickness="0" />
            <TextBlock x:Name="StatusText" Text="Add one or more PDFs, arrange pages, and choose an output file."
                       Margin="0,8,0,0" TextWrapping="Wrap"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11"
                       Foreground="{StaticResource InkSoft}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <Button x:Name="RunButton" Content="Build PDF" Style="{StaticResource Primary}"
                    Click="OnBuild" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsEnabled="False" Margin="0,0,8,0" />
            <Button x:Name="OpenOutputButton" Content="Open output" Click="OnOpenOutput" />
        </StackPanel>
    </Grid>
</Window>
