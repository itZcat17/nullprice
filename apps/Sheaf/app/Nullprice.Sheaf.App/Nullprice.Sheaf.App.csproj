<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Nullprice.Sheaf.Core\Nullprice.Sheaf.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Versioned Windows TFM (rather than plain net10.0-windows) is required for the SDK to
         generate WinRT projections, which Windows.Data.Pdf needs for page rendering. This is
         a build-time contract only and does not raise the runtime OS floor stated elsewhere
         (Windows 10 1809 or later). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
