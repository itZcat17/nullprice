<Window x:Class="Nullprice.Ferry.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ferry" Height="640" Width="920"
        MinHeight="480" MinWidth="720"
        Background="#EEF0F1"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#12171A" />
        <SolidColorBrush x:Key="InkSoft" Color="#5A656C" />
        <SolidColorBrush x:Key="Line" Color="#DCE1E4" />
        <SolidColorBrush x:Key="Accent" Color="#12674A" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C3CBD0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="FERRY" FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
            <TextBlock Text="Copy files and verify every one of them arrived intact."
                       Foreground="{StaticResource InkSoft}" Margin="0,2,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="SOURCES" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="AddFilesButton" Content="Add files…" Click="OnAddFiles" Margin="0,0,8,0" />
                    <Button x:Name="AddFolderButton" Content="Add folder…" Click="OnAddFolder" Margin="0,0,8,0" />
                    <Button x:Name="ClearButton" Content="Clear" Click="OnClear" />
                </StackPanel>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" Height="92">
                    <ListBox x:Name="SourceList" BorderThickness="0" Background="Transparent"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="DESTINATION" Style="{StaticResource FieldLabel}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="DestButton" Content="Choose folder…" Click="OnChooseDestination" />
                </StackPanel>
                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White" Height="92">
                    <TextBlock x:Name="DestText" Text="No destination chosen" Margin="10"
                               TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                               Foreground="{StaticResource InkSoft}" />
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White">
            <ListBox x:Name="ResultList" BorderThickness="0" Background="Transparent"
                     FontFamily="Cascadia Mono, Consolas" FontSize="11"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />
        </Border>

        <StackPanel Grid.Row="3" Margin="0,14,0,14">
            <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="1"
                         Foreground="{StaticResource Accent}" Background="#DCE1E4"
                         BorderThickness="0" />
            <TextBlock x:Name="StatusText" Text="Idle" Margin="0,8,0,0"
                       FontFamily="Cascadia Mono, Consolas" FontSize="11"
                       Foreground="{StaticResource InkSoft}" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal">
            <TextBlock Text="If it already exists:" VerticalAlignment="Center"
                       Foreground="{StaticResource InkSoft}" Margin="0,0,8,0" />
            <ComboBox x:Name="PolicyBox" Width="130" VerticalContentAlignment="Center" Margin="0,0,20,0">
                <ComboBoxItem Content="Overwrite" IsSelected="True" />
                <ComboBoxItem Content="Skip" />
                <ComboBoxItem Content="Rename" />
                <ComboBoxItem Content="Fail" />
            </ComboBox>

            <CheckBox x:Name="VerifyBox" Content="Verify after writing" IsChecked="True"
                      VerticalAlignment="Center" Foreground="{StaticResource Ink}" Margin="0,0,20,0" />

            <Button x:Name="StartButton" Content="Start transfer" Style="{StaticResource Primary}"
                    Click="OnStart" Margin="0,0,8,0" />
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
