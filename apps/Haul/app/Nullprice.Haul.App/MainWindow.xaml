<Window x:Class="Nullprice.Haul.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Haul" Height="700" Width="900"
        MinHeight="480" MinWidth="700"
        Background="#EEF0F1"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#12171A" />
        <SolidColorBrush x:Key="InkSoft" Color="#5A656C" />
        <SolidColorBrush x:Key="Line" Color="#DCE1E4" />
        <SolidColorBrush x:Key="Accent" Color="#12674A" />
        <SolidColorBrush x:Key="Warn" Color="#A8442B" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#C3CBD0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,8" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkSoft}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="HAUL" FontFamily="Segoe UI Variable Display, Segoe UI"
                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource Ink}" />
            <TextBlock Text="Download video and audio from a link, trim it, and adjust its speed — entirely on this machine."
                       Foreground="{StaticResource InkSoft}" Margin="0,2,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="White"
                Padding="20" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="VIDEO OR AUDIO URL" Style="{StaticResource FieldLabel}" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox" Grid.Column="0" Padding="8,6" VerticalContentAlignment="Center"
                             BorderBrush="{StaticResource Line}" Margin="0,0,10,0" />
                    <Button x:Name="ProbeButton" Grid.Column="1" Content="Probe" Click="ProbeButton_Click" />
                </Grid>

                <TextBlock x:Name="ResultText" Foreground="{StaticResource InkSoft}"
                           TextWrapping="Wrap" Margin="0,0,0,14" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="DownloadProgress" Grid.Column="0" Height="20"
                                 Minimum="0" Maximum="1" Margin="0,0,10,0" />
                    <Button x:Name="DownloadButton" Grid.Column="1" Style="{StaticResource Primary}"
                            Content="Download" IsEnabled="False" Click="DownloadButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Text="Ready." Margin="0,12,0,0"
                    FontFamily="Cascadia Mono, Consolas" FontSize="11"
                    Foreground="{StaticResource InkSoft}" />
    </Grid>
</Window>
